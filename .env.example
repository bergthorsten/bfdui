# Local macOS release settings. Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name or Company (TEAMID)"
APPLE_ID="you@example.com"
APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"
APPLE_TEAM_ID="xxxxxxxx"

# Optional if gh is not already authenticated. Needed for npm run release:mac.
# GITHUB_TOKEN="github_pat_..."
